---
// One "Unterm vs <competitor>" comparison page body. Rendered inside Base by
// both /compare/[slug].astro (en) and /[lang]/compare/[slug].astro.
//
// Content model lives in ../data/competitors.ts; prose is i18n via cmp.c.<slug>.*
// and cmp.page.* keys. The feature table reuses the homepage #compare styling
// but as a focused 3-column Feature | Unterm | <competitor> matrix.

import enUS from "../i18n/en-US.json";
import {
  CMP_ROWS,
  UNTERM_VALUES,
  COMPETITORS,
  type Competitor,
} from "../data/competitors";

interface Props {
  dict: Record<string, string>;
  pathPrefix: string;
  competitor: Competitor;
}

const { dict, pathPrefix, competitor } = Astro.props as Props;
const t = (k: string) => dict[k] ?? (enUS as Record<string, string>)[k] ?? k;

const name = competitor.name;
const slug = competitor.slug;
const fill = (k: string) => t(k).replaceAll("{name}", name);

// Honest angle bullets (a1..aN) that actually exist for this competitor.
const angles = Array.from({ length: competitor.angleCount }, (_, i) => `cmp.c.${slug}.a${i + 1}`);

// Cross-links to the other comparisons (internal linking for SEO).
const others = COMPETITORS.filter((c) => c.slug !== slug);

const homeHref = pathPrefix + "/";
const compareBase = pathPrefix + "/compare/";
const dlLatest = "https://github.com/zhitongblog/unterm/releases/latest";
---

<main class="max-w-4xl mx-auto px-6 py-14">
  <!-- Breadcrumb -->
  <nav class="text-xs text-notion-faint flex items-center gap-2" aria-label="Breadcrumb">
    <a href={homeHref} class="hover:text-notion-ink">{t("cmp.page.crumb_home")}</a>
    <span>/</span>
    <span class="text-notion-muted">{t("cmp.page.crumb")}</span>
    <span>/</span>
    <span class="text-notion-ink">Unterm vs {name}</span>
  </nav>

  <!-- Header -->
  <header class="mt-6">
    <p class="text-xs font-mono uppercase tracking-wider text-notion-teal">
      {t(`cmp.page.cat.${competitor.category}`)}
    </p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">
      Unterm <span class="text-notion-faint font-normal">vs</span> {name}
    </h1>
    <p class="mt-4 text-lg text-notion-muted max-w-2xl">{fill(`cmp.c.${slug}.tagline`)}</p>
  </header>

  <!-- Intro -->
  <p class="mt-8 text-notion-ink/90 leading-relaxed max-w-2xl" set:html={fill(`cmp.c.${slug}.intro`)}></p>

  <!-- Feature matrix: Feature | Unterm | competitor -->
  <div class="mt-10 overflow-x-auto rounded-xl border border-notion-border">
    <table class="w-full text-sm">
      <thead class="bg-notion-surface/80 text-notion-muted">
        <tr>
          <th class="text-left px-4 py-3 font-medium">{t("cmp.h.feature")}</th>
          <th class="px-3 py-3 font-semibold text-notion-green border-l border-notion-border">Unterm</th>
          <th class="px-3 py-3 font-medium border-l border-notion-border">{name}</th>
        </tr>
      </thead>
      <tbody class="text-notion-ink">
        {CMP_ROWS.map((r) => (
          <tr class="border-t border-notion-border">
            <td class="px-4 py-2.5">{t(r.key)}</td>
            <td class="text-center text-notion-green font-medium border-l border-notion-border/60 bg-notion-bg/10">
              {t(UNTERM_VALUES[r.key])}
            </td>
            <td class="text-center text-notion-muted border-l border-notion-border/60">
              {t(competitor.values[r.key] ?? "—")}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-notion-faint" set:html={t("cmp.legend")}></p>

  <!-- Why Unterm -->
  <section class="mt-14">
    <h2 class="text-2xl font-semibold tracking-tight">{t("cmp.page.why")}</h2>
    <ul class="mt-5 space-y-3">
      {angles.map((a) => (
        <li class="flex gap-3 text-notion-ink/90 leading-relaxed">
          <span class="text-notion-green mt-0.5">✓</span>
          <span set:html={fill(a)}></span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Where the competitor is stronger (honest) -->
  <section class="mt-12 rounded-xl border border-notion-border bg-notion-surface/40 p-6">
    <h2 class="text-lg font-semibold tracking-tight text-notion-ink">{fill("cmp.page.where")}</h2>
    <p class="mt-3 text-notion-muted leading-relaxed" set:html={fill(`cmp.c.${slug}.win`)}></p>
  </section>

  <!-- Verdict -->
  <section class="mt-12">
    <h2 class="text-2xl font-semibold tracking-tight">{t("cmp.page.verdict")}</h2>
    <p class="mt-4 text-notion-ink/90 leading-relaxed max-w-2xl" set:html={fill(`cmp.c.${slug}.verdict`)}></p>
  </section>

  <!-- CTA -->
  <section class="mt-12 flex flex-wrap items-center gap-4">
    <a href={dlLatest}
       class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-notion-green hover:bg-notion-teal text-zinc-950 font-semibold transition">
      {t("cmp.page.cta")}
    </a>
    <a href={competitor.url} target="_blank" rel="noopener nofollow"
       class="text-sm text-notion-muted hover:text-notion-ink">{fill("cmp.page.visitsite")}</a>
  </section>
  <p class="mt-3 text-xs text-notion-faint">{t("cmp.page.ctahint")}</p>

  <!-- Cross-links -->
  <section class="mt-16 pt-8 border-t border-notion-border">
    <h2 class="text-sm font-semibold text-notion-muted">{t("cmp.page.others")}</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {others.map((c) => (
        <a href={compareBase + c.slug}
           class="text-sm px-3 py-1.5 rounded-lg border border-notion-border text-notion-ink hover:border-notion-borderStrong hover:text-notion-teal transition">
          Unterm vs {c.name}
        </a>
      ))}
    </div>
    <p class="mt-6">
      <a href={homeHref} class="text-sm text-notion-teal hover:underline">{t("cmp.page.backhome")}</a>
    </p>
  </section>
</main>
